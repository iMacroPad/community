 "rules": {
  "safeHTML": [
   [
    "<\\s*/?\\s*(script|noscript|template)\\b",
    "it contains a script"
   ],
   [
    "<\\s*(iframe|frame|frameset|object|embed|applet|portal|webview)\\b",
    "it embeds another page or program"
   ],
   [
    "<\\s*(form|input|button|textarea|select|option|dialog)\\b",
    "it has form controls, which could send data"
   ],
   [
    "<\\s*(link|meta|base)\\b",
    "it has a link, meta or base tag, which can load or redirect"
   ],
   [
    "<\\s*(audio|video|source|track|picture)\\b",
    "it loads media"
   ],
   [
    "\\bon[a-z]+\\s*=",
    "it has an event handler (onclick, onerror…)"
   ],
   [
    "(javascript|vbscript|livescript)\\s*:",
    "it has a script link"
   ],
   [
    "data\\s*:\\s*(?!image/(png|jpeg|jpg|gif|webp)[;,])",
    "it has a data: link that is not a picture"
   ],
   [
    "\\b(src|srcset|href|action|formaction|poster|background|ping|manifest|xlink:href|data)\\s*=\\s*[\"']?\\s*(?!data:image/|#)[^\"'\\s>]",
    "it points outside itself (src, href…); only pictures written into the widget (data:image) are allowed"
   ],
   [
    "url\\s*\\(\\s*[\"']?\\s*(?!data:image/)",
    "its style loads something from outside"
   ],
   [
    "@import|expression\\s*\\(|-moz-binding|behavior\\s*:",
    "its style can load or run something"
   ],
   [
    "&#x?[0-9a-f]+;?\\s*(&#|[a-z]*:)",
    "it hides a link behind character codes"
   ],
   [
    "<\\s*svg[^>]*>[\\s\\S]*<\\s*(foreignobject|use|image|animate|set)\\b",
    "its drawing loads or animates from outside"
   ]
  ],
  "safeHTMLMaxBytes": 200000,
  "danger": [
   [
    "\\|\\s*(sudo\\s+)?(ba|z|da|fi)?sh\\b",
    "which pipes something into a shell"
   ],
   [
    "\\b(curl|wget)\\b[^\\n]*(\\||>|&&|;)",
    "which downloads and then runs or writes something"
   ],
   [
    "\\brm\\s+(-[a-z]*\\s+)*-[a-z]*[rf]",
    "which deletes files"
   ],
   [
    "\\bsudo\\b",
    "which asks for administrator rights"
   ],
   [
    "\\bbase64\\s+(-d|--decode)",
    "which unpacks hidden text"
   ],
   [
    "\\b(osascript|launchctl|crontab|csrutil|spctl|diskutil|dscl|mkfs|nvram)\\b",
    "which changes how the Mac itself runs"
   ],
   [
    "\\bchmod\\s+[+0-9a-z]*x",
    "which makes a file runnable"
   ],
   [
    "\\bdd\\s+if=",
    "which overwrites a disk"
   ],
   [
    ":\\(\\)\\s*\\{",
    "which is a fork bomb"
   ],
   [
    "\\bdefaults\\s+(write|delete)\\b",
    "which changes app or system settings"
   ],
   [
    "\\bsecurity\\s+(find|dump|export|delete|unlock)",
    "which reads the keychain"
   ],
   [
    "(\\.ssh/|id_rsa|id_ed25519|\\.aws/credentials|\\.netrc|/etc/passwd|\\.zsh_history|\\.bash_history)",
    "which touches keys or credentials"
   ],
   [
    ">>?\\s*~?/?[^\\s]*\\.(zshrc|zprofile|bashrc|bash_profile|profile)\\b",
    "which changes what every new terminal runs"
   ],
   [
    "\\b(nc|ncat|netcat|socat)\\s+-?[a-z]*\\s*\\S+\\s+[0-9]+",
    "which opens a raw network connection"
   ],
   [
    "\\b(python3?|perl|ruby|node|php)\\s+-[ce]\\b",
    "which runs code written into the key"
   ],
   [
    "\\beval\\b|\\$\\(\\s*(curl|wget)",
    "which runs text as code"
   ],
   [
    "/dev/tcp/",
    "which opens a raw network connection"
   ],
   [
    "\\bkillall\\s+-9|\\bkill\\s+-9\\s+-1",
    "which kills running programs"
   ],
   [
    "ignore (all |any |the )?(previous|prior|above|earlier|system) (instructions|rules|prompts?)|(önceki|yukarıdaki|sistem) (talimat|komut|kural)[a-zçğıöşü]* (yoksay|unut|görmezden)",
    "which tells an assistant to drop its instructions"
   ],
   [
    "\\b(delete|erase|wipe|destroy|shred|format) (all |every |the entire |the whole |my |the user'?s )[a-z ]{0,30}(files?|data|disks?|drives?|databases?|e-?mails?|repos?|repositor|folders?|director|backups?|history)",
    "which asks for files or data to be destroyed"
   ],
   [
    "(tüm|bütün|her) ?[a-zçğıöşü ]{0,24}(dosya|veri|disk|e-?posta|yedek|klasör|depo)[a-zçğıöşü]* ?(sil|yok et|temizle|formatla|kaldır)",
    "which asks for files or data to be destroyed"
   ],
   [
    "\\b(exfiltrat|siphon off|sızdır|ele geçir)",
    "which asks for data to be taken out"
   ],
   [
    "\\b(send|upload|post|e-?mail|forward|share|paste|leak)\\b[^.\\n]{0,60}(passwords?|credentials?|api[ _-]?keys?|tokens?|secrets?|private keys?|ssh keys?|keychain|cookies|\\.env\\b|browser history)",
    "which asks for passwords, keys or tokens to be sent somewhere"
   ],
   [
    "(şifre|parola|kimlik bilgi|anahtar|token|gizli bilgi|çerez)[a-zçğıöşü ]{0,40}(gönder|yükle|paylaş|ilet|sızdır)",
    "which asks for passwords, keys or tokens to be sent somewhere"
   ],
   [
    "\\b(disable|turn off|bypass)\\b[a-z ]{0,20}(firewall|gatekeeper|system integrity|antivirus|security|safety|sandbox|permissions?|approval)|(güvenlik duvarı|güvenliğ|antivirüs|korumay)[a-zçğıöşü ]{0,20}(kapat|devre dışı|atla)",
    "which asks for a protection to be switched off"
   ],
   [
    "--dangerously-skip-permissions|--yolo\\b|--no-verify\\b|without (asking|confirmation|approval|permission)|(onay|izin)[a-zçğıöşü ]{0,12}(almadan|istemeden|sormadan)",
    "which asks for something to be done without your approval"
   ]
  ]
 }
}
