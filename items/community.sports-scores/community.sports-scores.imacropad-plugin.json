{
  "format": 1,
  "id": "community.sports-scores",
  "name": "Sports scores",
  "version": "1.1.0",
  "author": "iMacroPad community",
  "blurb": "Your team on the pad: the next match, the last scores and the league table. Football, volleyball, basketball, NFL, NHL, F1 and more. Set your team or league on the widget (Edit ▸ the widget ▸ Live data); IDs are on thesportsdb.com (team page address). F1: your team’s and your driver’s standing and the next race in your time zone. Data: TheSportsDB free feed, ESPN and Jolpica (F1).",
  "icon": "sportscourt",
  "permissions": [
    {
      "capability": "network",
      "reason": "The Mac asks TheSportsDB, ESPN and Jolpica for fixtures, scores and tables. Only the team or league you set is sent."
    },
    {
      "capability": "liveData",
      "reason": "The widgets show those answers and ask again every few minutes while on screen."
    },
    {
      "capability": "html",
      "reason": "The scoreboard and the tables are small static HTML pages; no script, nothing loaded."
    }
  ],
  "integrations": [
    {
      "name": "team-next",
      "title": "Team: next matches",
      "kind": "rest",
      "method": "GET",
      "url": "https://www.thesportsdb.com/api/v1/json/123/eventsnext.php?id=${input:team}"
    },
    {
      "name": "team-last",
      "title": "Team: last results",
      "kind": "rest",
      "method": "GET",
      "url": "https://www.thesportsdb.com/api/v1/json/123/eventslast.php?id=${input:team}"
    },
    {
      "name": "league-table",
      "title": "League table",
      "kind": "rest",
      "method": "GET",
      "url": "https://www.thesportsdb.com/api/v1/json/123/lookuptable.php?l=${input:league}"
    },
    {
      "name": "league-next",
      "title": "League: coming up",
      "kind": "rest",
      "method": "GET",
      "url": "https://www.thesportsdb.com/api/v1/json/123/eventsnextleague.php?id=${input:league}"
    },
    {
      "name": "us-standings",
      "title": "US league standings (ESPN)",
      "kind": "rest",
      "method": "GET",
      "url": "https://site.api.espn.com/apis/v2/sports/${input:sport}/${input:league}/standings"
    },
    {
      "name": "f1-drivers",
      "title": "F1 driver standings",
      "kind": "rest",
      "method": "GET",
      "url": "https://api.jolpi.ca/ergast/f1/current/driverStandings.json"
    },
    {
      "name": "f1-constructor",
      "title": "F1 team standing",
      "kind": "rest",
      "method": "GET",
      "url": "https://api.jolpi.ca/ergast/f1/current/constructors/${input:team}/constructorStandings.json"
    },
    {
      "name": "f1-driver",
      "title": "F1 driver standing",
      "kind": "rest",
      "method": "GET",
      "url": "https://api.jolpi.ca/ergast/f1/current/drivers/${input:driver}/driverStandings.json"
    },
    {
      "name": "f1-next-race",
      "title": "F1 next race",
      "kind": "rest",
      "method": "GET",
      "url": "https://api.jolpi.ca/ergast/f1/current/next.json"
    }
  ],
  "components": [
    {
      "kind": "markdown",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.25
      },
      "style": {
        "tint": "surface",
        "label": "Next match · Galatasaray"
      },
      "content": "{{#events|1}}### {{strLeague}}\n# {{strHomeTeam}} – {{strAwayTeam}}\n**{{strTimestamp|date}}**{{#strVenue}} · {{strVenue}}{{/strVenue}}\n{{/events}}{{^events}}No match coming up.{{/events}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
          "name": "team-next"
        }
      },
      "settings": {
        "team": "133804"
      },
      "param": "900"
    },
    {
      "kind": "html",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.1875
      },
      "style": {
        "tint": "surface",
        "label": "Last score · Galatasaray"
      },
      "content": "{{#results|1}}<div style=\"font-size:11px;opacity:.6;letter-spacing:.05em\">{{strLeague}} · {{dateEvent|date}}</div><div style=\"display:flex;align-items:center;justify-content:space-between;margin-top:8px;gap:8px\"><div style=\"flex:1;text-align:center;font-weight:600\">{{strHomeTeam}}</div><div style=\"font-size:34px;font-weight:800;font-variant-numeric:tabular-nums\">{{intHomeScore}}<span style=\"opacity:.4\"> : </span>{{intAwayScore}}</div><div style=\"flex:1;text-align:center;font-weight:600\">{{strAwayTeam}}</div></div>{{/results}}{{^results}}No result yet.{{/results}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
          "name": "team-last"
        }
      },
      "settings": {
        "team": "133804"
      },
      "param": "600"
    },
    {
      "kind": "markdown",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.25
      },
      "style": {
        "tint": "surface",
        "label": "Results · Galatasaray"
      },
      "content": "### Results\n{{#results}}- {{dateEvent|date}} · {{strHomeTeam}} **{{intHomeScore}}–{{intAwayScore}}** {{strAwayTeam}}\n{{/results}}{{^results}}No results yet.{{/results}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
          "name": "team-last"
        }
      },
      "settings": {
        "team": "133804"
      },
      "param": "900"
    },
    {
      "kind": "html",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.5
      },
      "style": {
        "tint": "surface",
        "label": "Süper Lig table"
      },
      "content": "<table style=\"width:100%;font-size:13px\"><tr><th style=\"text-align:left;opacity:.6;font-weight:500;font-size:11px\">#</th><th style=\"text-align:left;opacity:.6;font-weight:500;font-size:11px\">Team</th><th style=\"text-align:left;opacity:.6;font-weight:500;font-size:11px\">P</th><th style=\"text-align:left;opacity:.6;font-weight:500;font-size:11px\">W-D-L</th><th style=\"text-align:left;opacity:.6;font-weight:500;font-size:11px\">GD</th><th style=\"text-align:left;opacity:.6;font-weight:500;font-size:11px\">Pts</th></tr>{{#table}}<tr><td>{{intRank}}</td><td>{{strTeam}}</td><td>{{intPlayed}}</td><td>{{intWin}}-{{intDraw}}-{{intLoss}}</td><td>{{intGoalDifference}}</td><td><b>{{intPoints}}</b></td></tr>{{/table}}</table>{{^table}}No table for this league on the free feed.{{/table}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
          "name": "league-table"
        }
      },
      "settings": {
        "league": "4339"
      },
      "param": "1800"
    },
    {
      "kind": "markdown",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.25
      },
      "style": {
        "tint": "surface",
        "label": "Next match · Halkbank (volleyball)"
      },
      "content": "{{#events|1}}### {{strLeague}}\n# {{strHomeTeam}} – {{strAwayTeam}}\n**{{strTimestamp|date}}**{{#strVenue}} · {{strVenue}}{{/strVenue}}\n{{/events}}{{^events}}No match coming up.{{/events}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
          "name": "team-next"
        }
      },
      "settings": {
        "team": "136621"
      },
      "param": "900"
    },
    {
      "kind": "html",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.1875
      },
      "style": {
        "tint": "surface",
        "label": "Last score · Maple Leafs (NHL)"
      },
      "content": "{{#results|1}}<div style=\"font-size:11px;opacity:.6;letter-spacing:.05em\">{{strLeague}} · {{dateEvent|date}}</div><div style=\"display:flex;align-items:center;justify-content:space-between;margin-top:8px;gap:8px\"><div style=\"flex:1;text-align:center;font-weight:600\">{{strHomeTeam}}</div><div style=\"font-size:34px;font-weight:800;font-variant-numeric:tabular-nums\">{{intHomeScore}}<span style=\"opacity:.4\"> : </span>{{intAwayScore}}</div><div style=\"flex:1;text-align:center;font-weight:600\">{{strAwayTeam}}</div></div>{{/results}}{{^results}}No result yet.{{/results}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
          "name": "team-last"
        }
      },
      "settings": {
        "team": "134837"
      },
      "param": "600"
    },
    {
      "kind": "html",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.5
      },
      "style": {
        "tint": "surface",
        "label": "NHL standings"
      },
      "content": "{{#children}}<div style=\"font-size:11px;opacity:.6;letter-spacing:.05em;margin-top:6px\">{{name}}</div><table style=\"width:100%;font-size:13px\">{{#standings.entries}}<tr><td>{{team.displayName}}</td><td style=\"text-align:right\">{{stats.overall.displayValue}}</td><td style=\"text-align:right;opacity:.6\">{{stats.streak.displayValue}}</td></tr>{{/standings.entries}}</table>{{/children}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
          "name": "us-standings"
        }
      },
      "settings": {
        "sport": "hockey",
        "league": "nhl"
      },
      "param": "1800"
    },
    {
      "kind": "html",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.5
      },
      "style": {
        "tint": "surface",
        "label": "NFL standings"
      },
      "content": "{{#children}}<div style=\"font-size:11px;opacity:.6;letter-spacing:.05em;margin-top:6px\">{{name}}</div><table style=\"width:100%;font-size:13px\">{{#standings.entries}}<tr><td>{{team.displayName}}</td><td style=\"text-align:right\">{{stats.overall.displayValue}}</td><td style=\"text-align:right;opacity:.6\">{{stats.streak.displayValue}}</td></tr>{{/standings.entries}}</table>{{/children}}",
      "action": {
        "integration": {
