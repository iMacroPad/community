{
  "format": 1,
  "id": "community.status-widgets",
  "name": "Status widgets",
  "version": "2.0.0",
  "author": "iMacroPad community",
  "blurb": "Is it down, or is it me? The status of the services you depend on — GitHub, Cloudflare, Claude, OpenAI, Vercel, npm, Docker, Jira, Figma and more, or any status page you add — with a coloured banner when something breaks and the incident's name, plus site monitors that check an address every 30 seconds and draw its response times and uptime. A Status board layout comes with it.",
  "icon": "square.grid.3x3.square",
  "permissions": [
    {
      "capability": "keys",
      "reason": "The Screenshot key presses its system shortcut and the Scroll dial scrolls the page."
    }
  ],
  "components": [
    {
      "kind": "info",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.5
      },
      "style": {
        "tint": "surface",
        "label": "Developer services"
      },
      "infoID": "status.services",
      "param": "github,cloudflare,claude,openai,vercel,npm,docker,supabase"
    },
    {
      "kind": "info",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.5
      },
      "style": {
        "tint": "surface",
        "label": "Work tools"
      },
      "infoID": "status.services",
      "param": "atlassian,jira,figma,notion,linear,discord,dropbox,stripe"
    },
    {
      "kind": "info",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.5
      },
      "style": {
        "tint": "surface",
        "label": "apple.com"
      },
      "infoID": "status.site",
      "param": "https://www.apple.com"
    },
    {
      "kind": "info",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.5
      },
      "style": {
        "tint": "surface",
        "label": "github.com"
      },
      "infoID": "status.site",
      "param": "https://github.com"
    },
    {
      "kind": "info",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.5
      },
      "style": {
        "tint": "surface",
        "label": "Your site"
      },
      "infoID": "status.site",
      "param": "https://www.imacropad.app"
    },
    {
      "kind": "button",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.167,
        "h": 0.125
      },
      "style": {
        "iconSystemName": "camera",
        "label": "Screenshot"
      },
      "action": {
        "keyChord": {
          "_0": {
            "key": "4",
            "modifiers": [
              "command",
              "shift"
            ]
          }
        }
      }
    },
    {
      "kind": "knob",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.333,
        "h": 0.25
      },
      "style": {
        "tint": "accent",
        "shape": "circle",
        "iconSystemName": "arrow.up.arrow.down",
        "label": "Scroll"
      },
      "action": {
        "scrollBy": {
          "dx": 0,
          "dy": 3
        }
      },
      "altAction": {
        "scrollBy": {
          "dx": 0,
          "dy": -3
        }
      }
    }
  ],
  "profiles": [
    {
      "name": "Status board",
      "icon": "checkmark.seal",
      "layout": {
        "columns": 12,
        "rows": 8,
        "backgroundHex": "#000000",
        "widgets": [
          {
            "kind": "info",
            "frame": {
              "x": 0,
              "y": 0,
              "w": 0.55,
              "h": 0.5
            },
            "style": {
              "tint": "surface",
              "label": "Developer services"
            },
            "infoID": "status.services",
            "param": "github,cloudflare,claude,openai,vercel,npm,docker,supabase"
          },
          {
            "kind": "info",
            "frame": {
              "x": 0,
              "y": 0.5,
              "w": 0.55,
              "h": 0.5
            },
            "style": {
              "tint": "surface",
              "label": "Work tools"
            },
            "infoID": "status.services",
            "param": "atlassian,jira,figma,notion,linear,discord,dropbox,stripe"
          },
          {
            "kind": "info",
            "frame": {
              "x": 0.55,
              "y": 0,
              "w": 0.45,
              "h": 0.3333333333333333
            },
            "style": {
              "tint": "surface",
              "label": "apple.com"
            },
            "infoID": "status.site",
            "param": "https://www.apple.com"
          },
          {
            "kind": "info",
            "frame": {
              "x": 0.55,
              "y": 0.3333333333333333,
              "w": 0.45,
              "h": 0.3333333333333333
            },
            "style": {
              "tint": "surface",
              "label": "github.com"
            },
            "infoID": "status.site",
            "param": "https://github.com"
          },
          {
            "kind": "info",
            "frame": {
              "x": 0.55,
              "y": 0.6666666666666666,
              "w": 0.45,
              "h": 0.3333333333333333
            },
            "style": {
              "tint": "surface",
              "label": "Your site"
            },
            "infoID": "status.site",
            "param": "https://www.imacropad.app"
          }
        ]
      }
    }
  ]
}
