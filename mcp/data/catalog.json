  "MacroAction": [
   {
    "name": "keyChord",
    "params": [
     {
      "label": "_0",
      "type": "KeyChord"
     }
    ],
    "doc": "A key + modifiers, e.g. ⌘/ for \"toggle comment\"."
   },
   {
    "name": "typeText",
    "params": [
     {
      "label": "_0",
      "type": "String"
     }
    ],
    "doc": "Type a literal string (passwords, snippets, \"One key = Q-W-E\")."
   },
   {
    "name": "runShortcut",
    "params": [
     {
      "label": "_0",
      "type": "String"
     }
    ],
    "doc": "Run a macOS Shortcut by name via `shortcuts run`."
   },
   {
    "name": "openApp",
    "params": [
     {
      "label": "bundleID",
      "type": "String"
     }
    ],
    "doc": "Bring an app to the front (bundle id)."
   },
   {
    "name": "openURL",
    "params": [
     {
      "label": "_0",
      "type": "String"
     }
    ],
    "doc": "Open a URL / file with the default handler."
   },
   {
    "name": "setVolume",
    "params": [
     {
      "label": "_0",
      "type": "Int"
     }
    ],
    "doc": "Set absolute output volume 0...100."
   },
   {
    "name": "mediaKey",
    "params": [
     {
      "label": "_0",
      "type": "MediaKey"
     }
    ],
    "doc": "Media/system key (see ceiling note in KeyInjector)."
   },
   {
    "name": "scrollBy",
    "params": [
     {
      "label": "dx",
      "type": "Double"
     },
     {
      "label": "dy",
      "type": "Double"
     }
    ],
    "doc": "Scroll the Mac by a wheel notch — knobs bind to this."
   },
   {
    "name": "sequence",
    "params": [
     {
      "label": "_0",
      "type": "[MacroAction]"
     }
    ],
    "doc": "Fire several actions in order — macros \"used in tandem\"."
   },
   {
    "name": "performIn",
    "params": [
     {
      "label": "bundleID",
      "type": "String"
     },
     {
      "label": "action",
      "type": "MacroAction"
     }
    ],
    "doc": "Bring a Mac app to the front, then perform `action` in it — lets the iPad drive an app that isn't frontmost (manual target mode)."
   },
   {
    "name": "obs",
    "params": [
     {
      "label": "_0",
      "type": "OBSCommand"
     }
    ],
    "doc": "OBS Studio via obs-websocket (daemon-side). Real state comes back as ServerMessage.obs."
   },
   {
    "name": "photoshop",
    "params": [
     {
      "label": "_0",
      "type": "PhotoshopCommand"
     }
    ],
    "doc": "Adobe Photoshop via AppleScript `do javascript` (daemon-side)."
   },
   {
    "name": "teams",
    "params": [
     {
      "label": "_0",
      "type": "TeamsCommand"
     }
    ],
    "doc": "Microsoft Teams meeting controls (chords + AX scripting, daemon-side)."
   },
   {
    "name": "menu",
    "params": [
     {
      "label": "bundleID",
      "type": "String?"
     },
     {
      "label": "path",
      "type": "[String]"
     }
    ],
    "doc": "Press a menu item by its titles, e.g. [\"Window\", \"Zoom\"]; works for items with no shortcut. A component like \"#3\" picks the third item of that menu. `bundleID` nil = the frontmost app."
   },
   {
    "name": "midi",
    "params": [
     {
      "label": "_0",
      "type": "MIDICommand"
     }
    ],
    "doc": "Send a MIDI message from the Mac's \"iMacroPad\" virtual source (daemon-side) — the pad as a control surface."
   },
   {
    "name": "integration",
    "params": [
     {
      "label": "plugin",
      "type": "String"
     },
     {
      "label": "name",
      "type": "String"
     }
    ],
    "doc": "A call an installed plugin defines (REST, WebSocket, MCP, gRPC), made by the Mac. The key only names it."
   },
   {
    "name": "wait",
    "params": [
     {
      "label": "seconds",
      "type": "Double"
     }
    ],
    "doc": "Pause for a while before the next step."
   },
   {
    "name": "click",
    "params": [
     {
      "label": "x",
      "type": "Double"
     },
     {
      "label": "y",
      "type": "Double"
     },
     {
      "label": "button",
      "type": "Int"
     }
    ],
    "doc": "Click at a point on the Mac's screen (global coordinates, top-left origin). `button` 0 = left, 1 = right."
   },
   {
    "name": "clickElement",
    "params": [
     {
      "label": "bundleID",
      "type": "String?"
     },
     {
      "label": "title",
      "type": "String"
     }
    ],
    "doc": "Press a button, checkbox or other control by its title or description in the app's windows (nil = front app)."
   },
   {
    "name": "waitFor",
    "params": [
     {
      "label": "_0",
