{
 "about": "Generated from the iMacroPad app's Swift model by scripts/gen-catalog.mjs. Info panel sizes (w, h) are grid cells; they read the same on a landscape 12×8 pad.",
 "widgetKinds": [
  {
   "kind": "button",
   "note": "tap → action"
  },
  {
   "kind": "knob",
   "note": "rotate CW → action, CCW → altAction, press → nothing/action"
  },
  {
   "kind": "slider",
   "note": "drag → setVolume-style continuous action"
  },
  {
   "kind": "trackpad",
   "note": "relative pointer + click"
  },
  {
   "kind": "trackball",
   "note": "relative pointer, momentum"
  },
  {
   "kind": "pencilArea",
   "note": "Apple Pencil drawing surface (pointer + pressure)"
  },
  {
   "kind": "label",
   "note": "static text / icon, no action"
  },
  {
   "kind": "toggle",
   "note": "stateful button: action = turn on, altAction = turn off; `stateKey` mirrors server state"
  },
  {
   "kind": "volumeKnob",
   "note": "knob with RGB LED ring + level meter, follows the Mac's real output volume"
  },
  {
   "kind": "colorWheel",
   "note": "Photoshop-style HSB wheel (hue ring + saturation/brightness square) → photoshop(.setForeground)"
  },
  {
   "kind": "brushPicker",
   "note": "brush size / hardness / opacity → photoshop(.setBrush)"
  },
  {
   "kind": "appSwitcher",
   "note": "strip of running Mac apps (real icons) → activate / set manual target"
  },
  {
   "kind": "obsScenes",
   "note": "dynamic OBS scene (and source) buttons fed by the daemon's OBS state"
  },
  {
   "kind": "obsStatus",
   "note": "recording / on air / paused with the running time; tap re-reads OBS"
  },
  {
   "kind": "obsMixer",
   "note": "OBS's audio mixer: a fader and a mute key per input"
  },
  {
   "kind": "obsPreview",
   "note": "a live picture of what OBS records or streams"
  },
  {
   "kind": "scrollStrip",
   "note": "mouse scroll wheel: rolls along its long side, with momentum"
  },
  {
   "kind": "roller",
   "note": "creative-console roller: a cylinder on its side, rolled across its short side"
  },
  {
   "kind": "rotary",
   "note": "flat dial turned with a fingertip"
  },
  {
   "kind": "chips",
   "note": "a named group of pill buttons (`options`), e.g. model or effort"
  },
  {
   "kind": "aiSessions",
   "note": "the terminal tabs and panes that run an AI tool → bring one to the front"
  },
  {
   "kind": "voice",
   "note": "a big microphone: tap, speak a command (built-in or one's own), see what was heard and done"
  },
  {
   "kind": "markdown",
   "note": "formatted text from `content`, or from the integration its action names"
  },
  {
   "kind": "html",
   "note": "a static HTML page: no script, no network, no forms"
  },
  {
   "kind": "chart",
   "note": "bars, a line or an area from numbers in `content` or from an integration"
  },
  {
   "kind": "info",
   "note": "an information panel (clock, weather, Mac state…): which one is `infoID`, see InfoCatalog"
  }
 ],
