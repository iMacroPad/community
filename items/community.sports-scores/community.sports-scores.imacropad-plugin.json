      "content": "{{#MRData.RaceTable.Races|1}}<div style=\"height:calc(100vh - 20px);display:flex;flex-direction:column;justify-content:space-between\"><div style=\"font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.6\">Next race · round {{round}}</div><div><div style=\"height:4px;width:56px;border-radius:2px;background:#e10600\"></div><div style=\"font-size:30px;font-weight:800;line-height:1.1;margin-top:10px\">{{raceName}}</div><div style=\"font-size:15px;opacity:.65;margin-top:4px\">{{Circuit.circuitName}} · {{Circuit.Location.locality}}, {{Circuit.Location.country}}</div></div><div><div style=\"font-size:10px;letter-spacing:.14em;opacity:.55\">LIGHTS OUT</div><div style=\"font-size:30px;font-weight:700;color:#e10600\">{{date|date:time}}</div></div><div style=\"display:flex;gap:26px;font-size:13px\">{{#FirstPractice}}<div><div style=\"font-size:10px;letter-spacing:.14em;opacity:.55\">PRACTICE 1</div>{{date|date:time}}</div>{{/FirstPractice}}{{#Sprint}}<div><div style=\"font-size:10px;letter-spacing:.14em;opacity:.55\">SPRINT</div>{{date|date:time}}</div>{{/Sprint}}{{#Qualifying}}<div><div style=\"font-size:10px;letter-spacing:.14em;opacity:.55\">QUALIFYING</div>{{date|date:time}}</div>{{/Qualifying}}</div></div>{{/MRData.RaceTable.Races}}{{^MRData.RaceTable.Races}}The season is over.{{/MRData.RaceTable.Races}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
