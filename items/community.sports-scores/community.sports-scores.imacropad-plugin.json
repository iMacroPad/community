      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.25
      },
      "style": {
        "tint": "surface",
        "label": "F1 next session"
      },
      "content": "{{#events|1}}### {{strLeague}} · round {{intRound}}\n# {{strEvent}}\n**{{strTimestamp|date}}**{{#strVenue}} · {{strVenue}}{{/strVenue}}\n{{/events}}{{^events}}Nothing scheduled.{{/events}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
          "name": "league-next"
        }
      },
      "settings": {
        "league": "4370"
      },
      "param": "1800"
    },
    {
      "kind": "html",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.375
      },
      "style": {
        "tint": "surface",
        "label": "F1 drivers"
      },
      "content": "{{#MRData.StandingsTable.StandingsLists|1}}<div style=\"font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.6;margin-bottom:10px\">Drivers · F1 {{season}} · after round {{round}}</div><table style=\"width:100%;font-size:16px\">{{#DriverStandings|10}}<tr><td style=\"width:28px;opacity:.55;text-align:right\">{{position}}</td><td><b>{{Driver.familyName}}</b> <span style=\"opacity:.55;font-size:13px\">{{Constructors.0.name}}</span></td><td style=\"text-align:right;font-weight:700\">{{points}}</td></tr>{{/DriverStandings}}</table>{{/MRData.StandingsTable.StandingsLists}}{{^MRData.StandingsTable.StandingsLists}}No standings yet this season.{{/MRData.StandingsTable.StandingsLists}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
          "name": "f1-drivers"
        }
      },
      "param": "3600"
    },
    {
      "kind": "html",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.375
      },
      "style": {
        "tint": "surface",
        "label": "F1 team · Ferrari"
      },
      "content": "{{#MRData.StandingsTable.StandingsLists|1}}{{#ConstructorStandings|1}}<div style=\"height:calc(100vh - 20px);display:flex;flex-direction:column;justify-content:space-between\"><div style=\"font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.6\">Constructors · F1 {{season}}</div><div><div style=\"height:4px;width:56px;border-radius:2px;background:#e10600\"></div><div style=\"display:flex;align-items:baseline;gap:14px;margin-top:8px\"><span style=\"font-size:64px;font-weight:800;line-height:1;color:#e10600\">P{{position}}</span><span style=\"font-size:28px;font-weight:700;line-height:1.1\">{{Constructor.name}}</span></div></div><div style=\"display:flex;gap:26px\"><div><div style=\"font-size:10px;letter-spacing:.14em;opacity:.55\">POINTS</div><div style=\"font-size:26px;font-weight:700\">{{points}}</div></div><div><div style=\"font-size:10px;letter-spacing:.14em;opacity:.55\">WINS</div><div style=\"font-size:26px;font-weight:700\">{{wins}}</div></div><div><div style=\"font-size:10px;letter-spacing:.14em;opacity:.55\">AFTER ROUND</div><div style=\"font-size:26px;font-weight:700\">{{round}}</div></div></div></div>{{/ConstructorStandings}}{{/MRData.StandingsTable.StandingsLists}}{{^MRData.StandingsTable.StandingsLists}}No standings yet this season.{{/MRData.StandingsTable.StandingsLists}}",
      "action": {
        "integration": {
          "plugin": "community.sports-scores",
          "name": "f1-constructor"
        }
      },
      "settings": {
        "team": "ferrari"
      },
      "param": "3600"
    },
    {
      "kind": "html",
      "frame": {
        "x": 0,
        "y": 0,
        "w": 0.5,
        "h": 0.375
      },
      "style": {
        "tint": "surface",
        "label": "F1 driver · Hamilton"
      },
      "content": "{{#MRData.StandingsTable.StandingsLists|1}}{{#DriverStandings|1}}<div style=\"height:calc(100vh - 20px);display:flex;flex-direction:column;justify-content:space-between\"><div style=\"font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.6\">Drivers · F1 {{season}}</div><div><div style=\"height:4px;width:56px;border-radius:2px;background:#e10600\"></div><div style=\"display:flex;align-items:baseline;gap:14px;margin-top:8px\"><span style=\"font-size:64px;font-weight:800;line-height:1;color:#e10600\">P{{position}}</span><span style=\"font-size:28px;font-weight:700;line-height:1.1\">{{Driver.givenName}} {{Driver.familyName}}<div style=\"font-size:14px;font-weight:500;opacity:.65;margin-top:4px\">#{{Driver.permanentNumber}} · {{Constructors.0.name}}</div></span></div></div><div style=\"display:flex;gap:26px\"><div><div style=\"font-size:10px;letter-spacing:.14em;opacity:.55\">POINTS</div><div style=\"font-size:26px;font-weight:700\">{{points}}</div></div><div><div style=\"font-size:10px;letter-spacing:.14em;opacity:.55\">WINS</div><div style=\"font-size:26px;font-weight:700\">{{wins}}</div></div><div><div style=\"font-size:10px;letter-spacing:.14em;opacity:.55\">AFTER ROUND</div><div style=\"font-size:26px;font-weight:700\">{{round}}</div></div></div></div>{{/DriverStandings}}{{/MRData.StandingsTable.StandingsLists}}{{^MRData.StandingsTable.StandingsLists}}No standings yet this season.{{/MRData.StandingsTable.StandingsLists}}",
